
# IslabControl.msg

uint64 timestamp           # Time since system start (microseconds)
uint64 timestamp_sample    # Timestamp when data was sampled (microseconds)

float64 vx                 # Target X velocity (m/s)
float64 vy                 # Target Y velocity (m/s)
float64 vz                 # Target Z velocity (m/s)

float64 vyaw                # Target yaw angle (degrees)